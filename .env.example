# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder values.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LLM provider: openai | gemini | openrouter (override with --provider)
LLM_PROVIDER=openai

# Gemini (Google AI Studio key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter (key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
